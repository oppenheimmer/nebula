# Release builds pin this to a digest (debian:trixie-slim@sha256:...) and a package
# snapshot; see ROADMAP M09.1. Development keeps the moving tag by default.
ARG BASE_IMAGE=debian:trixie-slim
FROM ${BASE_IMAGE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates clang cmake ninja-build \
        qt6-base-dev libgl1-mesa-dev libsqlite3-dev libxcb-cursor0 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk fonts-noto-color-emoji clang-format libclang-rt-dev \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8 \
    QT_QPA_PLATFORM=offscreen \
    NEBULA_REQUIRE_SAMPLE_FONTS=1 \
    XDG_CACHE_HOME=/tmp/nebula-cache \
    CMAKE_GENERATOR=Ninja

WORKDIR /workspace
USER 65532:65532
CMD ["/bin/bash"]
