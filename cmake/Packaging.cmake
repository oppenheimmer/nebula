include(GNUInstallDirs)
install(PROGRAMS "$<TARGET_FILE:nebula_prototype>" DESTINATION "${CMAKE_INSTALL_BINDIR}" RENAME nebula)
install(TARGETS nebula_workspace RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}")
install(FILES "${PROJECT_SOURCE_DIR}/packaging/nebula.desktop" DESTINATION "${CMAKE_INSTALL_DATADIR}/applications")
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/nebula" RENAME copyright)
install(FILES "${PROJECT_SOURCE_DIR}/README.md" "${PROJECT_SOURCE_DIR}/LICENSE"
    "${PROJECT_SOURCE_DIR}/ROADMAP.md" "${PROJECT_SOURCE_DIR}/AGENTS.md"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/nebula")
install(DIRECTORY "${PROJECT_SOURCE_DIR}/docs/" DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/nebula/docs")
install(DIRECTORY "${PROJECT_SOURCE_DIR}/assets/screenshots"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/doc/nebula/assets")
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    return()
endif()
set(NEBULA_PACKAGE_GENERATOR DEB CACHE STRING "Linux package format (DEB or RPM)")
set_property(CACHE NEBULA_PACKAGE_GENERATOR PROPERTY STRINGS DEB RPM)
if(NOT NEBULA_PACKAGE_GENERATOR MATCHES "^(DEB|RPM)$")
    message(FATAL_ERROR "NEBULA_PACKAGE_GENERATOR must be DEB or RPM")
endif()
set(CPACK_GENERATOR "${NEBULA_PACKAGE_GENERATOR}")
set(CPACK_PACKAGE_NAME nebula)
set(CPACK_PACKAGE_VERSION "${NEBULA_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Local single-user block notes and diary")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/oppenheimmer/nebula")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Nebula contributors")
set(CPACK_DEBIAN_PACKAGE_SECTION editors)
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
# Platform/TLS plugins and fonts are loaded dynamically, beyond ELF dependencies.
set(CPACK_DEBIAN_PACKAGE_DEPENDS "qt6-qpa-plugins, ca-certificates, fonts-dejavu-core, libxcb-cursor0")
set(CPACK_RPM_PACKAGE_LICENSE MIT)
set(CPACK_RPM_PACKAGE_RELEASE 1)
set(CPACK_RPM_PACKAGE_RELEASE_DIST ON)
set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
set(CPACK_RPM_PACKAGE_RELOCATABLE OFF)
set(CPACK_RPM_USER_FILELIST "%license /usr/share/doc/nebula/LICENSE")
# Restricted build containers provide writable /tmp rather than /var/tmp.
set(CPACK_RPM_SPEC_MORE_DEFINE "%define _tmppath /tmp")
# EL9's GUI package supplies dynamically loaded platform and image plugins;
# qt6-qtbase supplies the TLS backend. ELF dependencies remain auto-generated.
set(CPACK_RPM_PACKAGE_REQUIRES "qt6-qtbase-gui >= 6.5, ca-certificates, dejavu-sans-fonts")
set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION "/usr/share/applications")
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
set(CPACK_PACKAGE_FILE_NAME "nebula-${CPACK_PACKAGE_VERSION}-${CMAKE_SYSTEM_PROCESSOR}")
string(TOLOWER "${NEBULA_PACKAGE_GENERATOR}" package_extension)
file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/package-filename.txt" CONTENT "${CPACK_PACKAGE_FILE_NAME}.${package_extension}\n")
include(CPack)
